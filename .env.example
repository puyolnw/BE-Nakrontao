# Backend (Go API). Copy to .env for local runs; on Railway set these as service variables.
# Never commit .env.

# Railway sets PORT automatically. ADDR overrides it (e.g. 127.0.0.1:18080 for local dev).
PORT=8080

# Postgres with the pgvector extension (Railway: use a pgvector-enabled Postgres template).
DATABASE_URL=postgres://user:password@host:5432/sinakhontao?sslmode=require

# >= 32 random characters: openssl rand -hex 32
IP_HASH_SALT=
SECURE_COOKIES=true

# Networks whose X-Forwarded-For is trusted (the frontend proxy). Railway private network: fd00::/8
TRUSTED_PROXY=fd00::/8

# First admin, created only when the users table is empty. Change the password at first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=

# Demo/real content loaded once into an empty database. Leave empty to skip.
SEED_FILE=/app/seed/demo.sql
# Uploaded images; mount a volume here.
UPLOAD_DIR=/data/uploads

# AI (optional; without keys the site uses offline retrieval + extractive answers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EMBED_URL=https://api.openai.com/v1/embeddings
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

CHAT_PER_MINUTE=10
CHAT_DAILY_CAP=2000
RETENTION_DAYS=180
